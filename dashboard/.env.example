# ============================================================================
# MewBot Dashboard — Environment Variables Template
# Buat file ".env.local" untuk development lokal dan isi di Vercel Dashboard Settings
# ============================================================================

# Supabase Public (Client-Side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Supabase Private (Server-Side Saja — JANGAN PERNAH diekspos ke browser / firmware!)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# MewBot Device Master Salt (untuk hashing token perangkat)
DEVICE_TOKEN_SECRET_SALT="mewbot-secure-salt-phrase-2026"

